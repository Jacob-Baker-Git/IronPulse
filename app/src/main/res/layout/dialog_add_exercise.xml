<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <AutoCompleteTextView android:id="@+id/field_name" android:hint="Exercise name"
        android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="8dp"/>
    <EditText android:id="@+id/field_weight" android:hint="Weight (kg or BW)"
        android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="8dp"/>
    <EditText android:id="@+id/field_sets" android:hint="Sets (default 3)" android:inputType="number"
        android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="8dp"/>
    <EditText android:id="@+id/field_reps" android:hint="Reps (default 10)" android:inputType="number"
        android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginBottom="8dp"/>
    <EditText android:id="@+id/field_rest" android:hint="Rest seconds (default 90)" android:inputType="number"
        android:layout_width="match_parent" android:layout_height="44dp"/>

    <TextView android:text="Repeat on days"
        android:textSize="11sp" android:layout_marginTop="10dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <CheckBox android:id="@+id/day_mon" android:text="M" android:textSize="11sp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <CheckBox android:id="@+id/day_tue" android:text="T" android:textSize="11sp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <CheckBox android:id="@+id/day_wed" android:text="W" android:textSize="11sp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <CheckBox android:id="@+id/day_thu" android:text="T" android:textSize="11sp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <CheckBox android:id="@+id/day_fri" android:text="F" android:textSize="11sp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <CheckBox android:id="@+id/day_sat" android:text="S" android:textSize="11sp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <CheckBox android:id="@+id/day_sun" android:text="S" android:textSize="11sp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
