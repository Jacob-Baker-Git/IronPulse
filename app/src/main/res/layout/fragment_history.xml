<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Progress"
            android:textAppearance="@style/TextAppearance.IronPulse.PageTitle"/>

        <!-- Which lift -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/tile_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Spinner
                android:id="@+id/exercise_spinner"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:paddingEnd="16dp"
                android:text="▾"
                android:textColor="?attr/colorTextMuted"
                android:textSize="18sp"/>
        </LinearLayout>

        <!-- Metric toggle: training volume vs estimated 1RM -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/tile_bg"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/metric_volume"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Volume"
                android:textSize="13sp"/>
            <TextView
                android:id="@+id/metric_e1rm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Est. 1RM"
                android:textSize="13sp"/>
        </LinearLayout>

        <com.ironpulse.ui.HistoryChartView
            android:id="@+id/history_chart"
            android:layout_width="match_parent"
            android:layout_height="240dp"/>

        <!-- Shown instead of an empty chart -->
        <TextView
            android:id="@+id/chart_empty"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="@drawable/tile_bg"
            android:gravity="center"
            android:padding="20dp"
            android:textColor="?attr/colorTextMuted"
            android:textSize="14sp"
            android:visibility="gone"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.08"
            android:text="TRAINING CALENDAR"
            android:textColor="?attr/colorTextMuted"
            android:textSize="11sp"/>

        <com.ironpulse.ui.MonthHeatmapView
            android:id="@+id/month_heatmap"
            android:layout_width="match_parent"
            android:layout_height="230dp"/>
    </LinearLayout>
</ScrollView>
