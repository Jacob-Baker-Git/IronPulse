<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorScreenBg"
    android:padding="16dp">

    <TextView android:text="History"
        android:textColor="?attr/colorTextPrimary"
        android:textSize="22sp" android:textStyle="bold"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"/>

    <!-- Spinner with visible dropdown arrow -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="?attr/colorCardBg"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <Spinner android:id="@+id/exercise_spinner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="▾"
            android:textColor="?attr/colorTextMuted"
            android:textSize="18sp"
            android:paddingEnd="12dp"
            android:focusable="false"
            android:clickable="false"/>

    </LinearLayout>

    <!-- Chart fills all remaining space -->
    <com.ironpulse.ui.HistoryChartView
        android:id="@+id/history_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
