<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/colorScreenBg" android:padding="16dp">
    <TextView android:text="Cardio" android:textColor="?attr/colorTextPrimary"
        android:textSize="22sp" android:textStyle="bold"
        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp"
        android:orientation="horizontal" android:background="?attr/colorCardBg" android:padding="12dp"
        android:layout_marginBottom="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:text="This week" android:textColor="?attr/colorTextMuted" android:textSize="10sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/stat_week_dist" android:text="—" android:textColor="@color/accent"
                android:textSize="14sp" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:text="Sessions" android:textColor="?attr/colorTextMuted" android:textSize="10sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/stat_total_sessions" android:text="—" android:textColor="@color/accent"
                android:textSize="14sp" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:text="Best pace" android:textColor="?attr/colorTextMuted" android:textSize="10sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/stat_best_pace" android:text="—" android:textColor="@color/accent"
                android:textSize="14sp" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">
        <Button android:id="@+id/btn_add_cardio" android:text="+ Log Cardio Session"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginEnd="6dp"
            android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp"
            android:backgroundTint="@color/accent"/>
        <Button android:id="@+id/btn_cardio_edit" android:text="Edit"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:minWidth="72dp" android:minHeight="0dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:textColor="@color/white"
            android:background="@drawable/btn_secondary"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/cardio_list" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"/>
    </ScrollView>
</LinearLayout>
