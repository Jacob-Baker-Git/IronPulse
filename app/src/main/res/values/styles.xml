<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme (default) -->
    <style name="Theme.IronPulse" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorScreenBg">@color/bg_dark</item>
        <item name="colorCardBg">@color/card_bg</item>
        <item name="colorPanelBg">@color/panel_dark</item>
        <item name="colorTextPrimary">@color/text_primary</item>
        <item name="colorTextMuted">@color/text_muted</item>
        <item name="calToday">@color/cal_today</item>
        <item name="calRest">@color/cal_rest</item>
        <item name="calWorkout">@color/cal_workout</item>
        <item name="calEmpty">@color/cal_empty</item>
        <item name="calSelected">@color/cal_selected</item>
        <item name="streakTrack">@color/panel_mid</item>
        <item name="colorFieldBg">@color/field_bg</item>
        <item name="colorBorder">@color/border</item>
        <item name="android:popupMenuStyle">@style/IronPulse.Popup</item>
        <item name="android:alertDialogTheme">@style/IronPulse.Dialog</item>
        <item name="alertDialogTheme">@style/IronPulse.Dialog</item>
    </style>

    <!-- Light theme -->
    <style name="Theme.IronPulse.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/accent_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:textColor">@color/text_primary_light</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorScreenBg">@color/bg_light</item>
        <item name="colorCardBg">@color/card_bg_light</item>
        <item name="colorPanelBg">@color/panel_light</item>
        <item name="colorTextPrimary">@color/text_primary_light</item>
        <item name="colorTextMuted">@color/text_muted_light</item>
        <item name="calToday">@color/cal_today_light</item>
        <item name="calRest">@color/cal_rest_light</item>
        <item name="calWorkout">@color/cal_workout_light</item>
        <item name="calEmpty">@color/cal_empty_light</item>
        <item name="calSelected">@color/cal_selected_light</item>
        <item name="streakTrack">@color/streak_track_light</item>
        <item name="colorFieldBg">@color/field_bg_light</item>
        <item name="colorBorder">@color/border_light</item>
        <item name="android:popupMenuStyle">@style/IronPulse.Popup</item>
        <item name="android:alertDialogTheme">@style/IronPulse.Dialog.Light</item>
        <item name="alertDialogTheme">@style/IronPulse.Dialog.Light</item>
    </style>

    <style name="IronPulse.Popup" parent="@android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_bg</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <!-- Every AlertDialog (framework and AppCompat): card surface, rounded, mint sentence-case buttons -->
    <style name="IronPulse.Dialog" parent="@style/ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:buttonBarButtonStyle">@style/IronPulse.DialogButton</item>
        <item name="buttonBarButtonStyle">@style/IronPulse.DialogButton</item>
    </style>
    <style name="IronPulse.Dialog.Light" parent="@style/ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="colorPrimary">@color/accent_dark</item>
        <item name="colorAccent">@color/accent_dark</item>
        <item name="android:colorAccent">@color/accent_dark</item>
        <item name="android:buttonBarButtonStyle">@style/IronPulse.DialogButton.Light</item>
        <item name="buttonBarButtonStyle">@style/IronPulse.DialogButton.Light</item>
    </style>
    <style name="IronPulse.DialogButton" parent="@style/Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/accent</item>
    </style>
    <style name="IronPulse.DialogButton.Light">
        <item name="android:textColor">@color/accent_dark</item>
    </style>

    <!-- The one small round + used on every screen -->
    <style name="Widget.IronPulse.Fab" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="fabCustomSize">44dp</item>
        <item name="maxImageSize">20dp</item>
        <item name="backgroundTint">?attr/colorTextPrimary</item>
        <item name="tint">?attr/colorScreenBg</item>
        <item name="elevation">4dp</item>
        <item name="srcCompat">@drawable/ic_add</item>
    </style>

    <!-- Big page title used at the top of every screen -->
    <style name="TextAppearance.IronPulse.PageTitle" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
</resources>
