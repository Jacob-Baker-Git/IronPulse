<?xml version="1.0" encoding="utf-8"?>
<!-- Widget progress bar (RemoteViews can't tint at runtime, so colours are fixed here) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#232A36"/><corners android:radius="3dp"/></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="#3EE08F"/><corners android:radius="3dp"/></shape></clip>
    </item>
</layer-list>
