<?xml version="1.0" encoding="utf-8"?>
<!-- Progress bar inside Today's headline card -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#3304140C"/><corners android:radius="3dp"/></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="@color/on_accent"/><corners android:radius="3dp"/></shape></clip>
    </item>
</layer-list>
